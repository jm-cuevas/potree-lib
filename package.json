{
  "name": "potree-lib",
  "version": "0.1.0",
  "type": "module",
  "description": "Headless, modern npm port of the Potree point cloud viewer engine (viewer, loaders, materials, navigation, tools, modules) built on top of three.js.",
  "license": "BSD-2-Clause",
  "author": "Juan Cuevas <juan.m.cuevas@outlook.com>",
  "files": [
    "dist"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./loaders": {
      "types": "./dist/loaders/index.d.ts",
      "import": "./dist/loaders/index.js"
    },
    "./materials": {
      "types": "./dist/materials/index.d.ts",
      "import": "./dist/materials/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js"
    },
    "./exporters": {
      "types": "./dist/exporters/index.d.ts",
      "import": "./dist/exporters/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "dev": "vite examples",
    "build": "vite build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.169.0"
  },
  "dependencies": {
    "@ngageoint/geopackage": "^4.2.9",
    "@tweenjs/tween.js": "^25.0.0",
    "copc": "^0.0.9",
    "laz-perf": "^0.0.7",
    "proj4": "^2.11.0",
    "rtree-sql.js": "^1.7.0",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
